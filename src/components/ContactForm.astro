---
import Turnstile from './Turnstile.astro';
---
<form class="contact-form" data-contact-form>
  <div class="form-grid">
    <label><span>Name</span><input name="name" type="text" autocomplete="name" required maxlength="80" placeholder="Your name" /></label>
    <label><span>Email</span><input name="email" type="email" autocomplete="email" required maxlength="160" placeholder="you@example.com" /></label>
  </div>
  <div class="form-grid">
    <label><span>Phone / WhatsApp</span><input name="phone" type="tel" autocomplete="tel" maxlength="30" placeholder="+91 ..." /></label>
    <label><span>Project type</span><select name="projectType"><option value="Residential">Residential</option><option value="Commercial">Commercial</option><option value="Hospitality">Hospitality</option><option value="Other">Other</option></select></label>
  </div>
  <label><span>Tell us about the space</span><textarea name="message" rows="6" required maxlength="3000" placeholder="Location, approximate area, timeline and what you have in mind..."></textarea></label>
  <div class="honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
  <Turnstile />
  <button class="button button-dark" type="submit"><span data-submit-label>Send enquiry</span><span>↗</span></button>
  <p class="form-status" data-form-status role="status" aria-live="polite"></p>
</form>
<script>
  const form = document.querySelector('[data-contact-form]');
  if (form) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector('[data-form-status]');
      const button = form.querySelector('button[type="submit"]');
      const label = form.querySelector('[data-submit-label]');
      button.disabled = true;
      label.textContent = 'Sending…';
      status.textContent = '';
      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form)))
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Something went wrong.');
        form.reset();
        status.textContent = 'Thank you. Your enquiry has been sent.';
        if (window.turnstile) window.turnstile.reset();
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Please try again or contact us on WhatsApp.';
      } finally {
        button.disabled = false;
        label.textContent = 'Send enquiry';
      }
    });
  }
</script>
