---
import { site } from '../data/site';
---
<footer class="site-footer">
  <div class="footer-top">
    <div>
      <p class="eyebrow">Bhavna Space</p>
      <h2>Spaces with a sense of place.</h2>
    </div>
    <a class="footer-arrow" href="/contact/" aria-label="Go to contact">↗</a>
  </div>
  <div class="footer-grid">
    <div><span>Studio</span><p>{site.city}, India</p></div>
    <div><span>Contact</span><p><a href={`mailto:${site.email}`}>{site.email}</a><br /><a href={`tel:${site.phone.replaceAll(' ', '')}`}>{site.phone}</a></p></div>
    <div><span>Social</span><p><a href={site.instagram} target="_blank" rel="noreferrer">Instagram ↗</a></p></div>
  </div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} Bhavna Space</span><span>Interior Design Studio</span></div>
</footer>
