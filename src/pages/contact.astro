---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';

const whatsappInquiry = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent("Hello Bhavna Space, I would like to schedule an interior design consultation.")}`;
---

<Layout
  title={`Contact & Consultations — ${site.name}`}
  description="Contact Bhavna Space to discuss your residential interior architecture, bespoke joinery, or furniture commission in Mumbai."
  preloadImage="/images/studio-editorial.jpg"
>
  <header class="inner-page-hero theme-ivory">
    <div class="container">
      <div class="section-divider">
        <span>Studio Inquiries</span>
        <span>Mumbai &bull; Maharashtra</span>
      </div>

      <span class="eyebrow eyebrow-teal">Consultations</span>
      <h1 class="inner-page-hero-title">
        Tell us about<br /><em>your space.</em>
      </h1>
      <p class="inner-page-hero-lead">
        Whether you are planning a complete residential renovation, bespoke kitchen joinery, or custom furniture pieces, our studio welcomes the opportunity to explore your vision.
      </p>
    </div>
  </header>

  <section class="section-pad theme-ivory contact-main-section">
    <div class="container">
      <div class="contact-split-grid">
        <!-- Left Column: Direct Studio Information & Visual Anchor -->
        <div class="contact-info-col">
          <div class="studio-direct-card theme-cream">
            <span class="eyebrow">Direct Contact</span>
            <h2 class="direct-card-title">Studio Channels</h2>

            <div class="direct-channels-list">
              <div class="channel-row">
                <span class="channel-label">Telephone</span>
                <a href={`tel:${site.phone.replaceAll(' ', '')}`} class="channel-link">
                  {site.phone}
                </a>
              </div>

              <div class="channel-row">
                <span class="channel-label">Direct Email</span>
                <a href={`mailto:${site.email}`} class="channel-link">
                  {site.email}
                </a>
              </div>

              <div class="channel-row">
                <span class="channel-label">Instant Concierge</span>
                <a href={whatsappInquiry} target="_blank" rel="noreferrer" class="channel-link channel-link--accent">
                  Chat via WhatsApp ↗
                </a>
              </div>

              <div class="channel-row">
                <span class="channel-label">Studio Location</span>
                <span class="channel-static">{site.location}</span>
              </div>

              <div class="channel-row">
                <span class="channel-label">Office Hours</span>
                <span class="channel-static">Monday &ndash; Saturday &bull; 10:00 AM &ndash; 7:00 PM IST</span>
              </div>

              <div class="channel-row">
                <span class="channel-label">Editorial Feed</span>
                <a href={site.instagram} target="_blank" rel="noreferrer" class="channel-link channel-link--accent">
                  Instagram @bhavnaspace ↗
                </a>
              </div>
            </div>
          </div>

          <!-- Supporting Editorial Photograph -->
          <div class="contact-visual-frame image-reveal">
            <img
              src="/images/studio-editorial.jpg"
              alt="Bhavna Space design studio alcove with natural lime-wash plaster, tactile stone pedestal, and warm sunlight"
              width="800"
              height="600"
              class="contact-visual-img"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Right Column: Consultation Form -->
        <div class="contact-form-col">
          <div class="form-wrapper-card">
            <span class="eyebrow eyebrow-teal">Project Inquiry</span>
            <h2 class="form-section-title">Schedule a Consultation</h2>
            <p class="form-section-desc">
              Please share a few initial details about the property, your location, and your target timeline. Our design director will review your submission and reply within 24&ndash;48 business hours.
            </p>

            <ContactForm />
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-split-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: flex-start;
  }

  /* ── Left Direct Info Card ──────────────────────────────────────────── */
  .studio-direct-card {
    border: 1px solid var(--color-border);
    padding: clamp(2rem, 3.5vw, 3rem);
    border-radius: var(--radius-xs);
    margin-bottom: 2rem;
  }

  .direct-card-title {
    margin: 0 0 1.5rem 0;
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 2.6vw, 2.3rem);
    font-weight: 400;
    color: var(--color-espresso);
  }

  .direct-channels-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .channel-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-border);
  }

  .channel-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .channel-label {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .channel-link {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-espresso);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .channel-link:hover {
    color: var(--color-teal);
  }

  .channel-link--accent {
    color: var(--color-teal);
    font-weight: 600;
  }

  .channel-static {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .contact-visual-frame {
    border-radius: var(--radius-xs);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background-color: #D6CEC2;
  }

  .contact-visual-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Right Form Card ────────────────────────────────────────────────── */
  .form-wrapper-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    padding: clamp(2rem, 4.5vw, 3.5rem);
    border-radius: var(--radius-xs);
    box-shadow: 0 8px 30px rgba(48, 42, 37, 0.03);
  }

  .form-section-title {
    margin: 0.5rem 0 1rem 0;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    font-weight: 400;
    line-height: 1.15;
    color: var(--color-espresso);
  }

  .form-section-desc {
    margin: 0 0 2rem 0;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  @media (max-width: 991px) {
    .contact-split-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .contact-visual-frame {
      display: none;
    }
  }
</style>
