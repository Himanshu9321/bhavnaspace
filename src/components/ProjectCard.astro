---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
---

<article class:list={['editorial-project-card', { 'is-featured': featured }]}>
  <a href={`/projects/${project.slug}/`} class="card-link-wrapper" aria-label={`View project: ${project.title}`}>
    <!-- Image Media Container -->
    <div class="card-media-box image-reveal">
      <img
        src={project.hero}
        alt={`${project.title} — bespoke interior architecture by Bhavna Space`}
        width="1600"
        height="1100"
        class="card-img"
        loading={featured ? 'eager' : 'lazy'}
        decoding="async"
      />
      <div class="card-badge">
        <span>{project.category}</span>
      </div>
      <div class="card-hover-overlay">
        <span class="hover-text">View Project Details</span>
        <span class="hover-arrow" aria-hidden="true">&rarr;</span>
      </div>
    </div>

    <!-- Metadata Content Block -->
    <div class="card-meta">
      <div class="card-meta-header">
        <span class="card-index">№ {project.number}</span>
        <div class="card-pills">
          <span class="pill">{project.location}</span>
          <span class="pill-dot">&bull;</span>
          <span class="pill">{project.year}</span>
        </div>
      </div>
      <h3 class="card-title">{project.title}</h3>
      <p class="card-excerpt">{project.excerpt}</p>
    </div>
  </a>
</article>

<style>
  .editorial-project-card {
    position: relative;
    width: 100%;
    margin-bottom: 2rem;
  }

  .card-link-wrapper {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .card-media-box {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #E2DAD0;
    border-radius: var(--radius-xs);
    aspect-ratio: 16 / 10;
  }

  .is-featured .card-media-box {
    aspect-ratio: 16 / 9.5;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-link-wrapper:hover .card-img {
    transform: scale(1.035);
  }

  .card-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 2;
    background-color: rgba(246, 242, 234, 0.92);
    backdrop-filter: blur(8px);
    color: var(--color-espresso);
    padding: 6px 12px;
    border-radius: var(--radius-xs);
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .card-hover-overlay {
    position: absolute;
    bottom: 16px;
    right: 16px;
    z-index: 2;
    background-color: var(--color-teal);
    color: var(--color-ivory);
    padding: 10px 18px;
    border-radius: var(--radius-xs);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 8px;
    opacity: 0;
    transform: translateY(10px);
    transition: all 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-link-wrapper:hover .card-hover-overlay {
    opacity: 1;
    transform: translateY(0);
  }

  .hover-arrow {
    transition: transform 200ms ease;
  }

  .card-link-wrapper:hover .hover-arrow {
    transform: translateX(4px);
  }

  /* ── Metadata ───────────────────────────────────────────────────────── */
  .card-meta {
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    margin-top: 1rem;
  }

  .card-meta-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .card-index {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .card-pills {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .pill-dot {
    opacity: 0.4;
  }

  .card-title {
    margin: 0 0 0.5rem 0;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-espresso);
    transition: color 200ms ease;
  }

  .card-link-wrapper:hover .card-title {
    color: var(--color-teal);
  }

  .card-excerpt {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 650px;
  }

  @media (max-width: 767px) {
    .card-hover-overlay {
      display: none;
    }
  }
</style>
