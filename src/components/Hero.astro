---
import { site } from '../data/site';

interface Props {
  approachUrl?: string;
  consultationUrl?: string;
}

const { approachUrl = '/about/', consultationUrl } = Astro.props;
---

<section class="hero-section" id="hero" aria-label="Bhavna Space Hero">
  <!-- Photograph Column (Desktop Left / Mobile Full-Bleed Background) -->
  <div class="hero-media-wrapper">
    <picture class="hero-picture">
      <source srcset="/images/hero.webp" type="image/webp" />
      <img
        src="/images/hero.png"
        alt="Bhavna Space luxury minimalist living interior with sculptural seating, fluted timber joinery, honed travertine, and sweeping panoramic window landscape"
        class="hero-image"
        width="829"
        height="801"
        fetchpriority="high"
        loading="eager"
        decoding="sync"
      />
    </picture>
    <!-- Mobile bottom dark gradient scrim for crystal clear contrast -->
    <div class="hero-mobile-scrim" aria-hidden="true"></div>
  </div>

  <!-- Editorial Content Column (Desktop Right Ivory Panel / Mobile Lower Overlay) -->
  <div class="hero-content-wrapper">
    <div class="hero-content-inner">
      <!-- Antique Gold Decorative Line Accent (Desktop) -->
      <div class="hero-accent-mark" aria-hidden="true">
        <span class="gold-line"></span>
        <span class="gold-dot"></span>
      </div>

      <!-- Eyebrow Tag -->
      <p class="hero-eyebrow">
        <span class="hero-eyebrow-text">{site.descriptor}</span>
      </p>

      <!-- Main Editorial Headline: Semantic H1 -->
      <h1 class="hero-headline">
        <span class="headline-row">Spaces that feel</span>
        <span class="headline-row headline-row--accent"><em>like you.</em></span>
      </h1>

      <!-- Supporting Editorial Narrative -->
      <p class="hero-description hero-description--desktop">
        Thoughtfully designed interiors that bring together timeless aesthetics, everyday comfort, and meaningful details.
      </p>
      <p class="hero-description hero-description--mobile">
        Thoughtfully designed interiors that bring together timeless aesthetics, everyday comfort, and meaningful details.
      </p>

      <!-- Action Buttons -->
      <div class="hero-actions">
        <a href="/projects/" class="hero-cta-primary">
          <span>Explore Our Projects</span>
          <span class="hero-cta-arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a href={consultationUrl || approachUrl} class="hero-cta-secondary">
          <span>Discover Our Approach</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     HERO SECTION BASE (Mobile-First: Immersive Full-Bleed Photography)
     ========================================================================== */
  .hero-section {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 100svh;
    overflow: hidden;
    background-color: var(--color-ivory);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  /* ── Media Wrapper ──────────────────────────────────────────────────────── */
  .hero-media-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
    background-color: #DDD4C6;
  }

  .hero-picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 35%; /* Showcases curved seating, woodwork and daylight */
    display: block;
    transform-origin: center center;
    animation: heroImageSettle 1200ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Refined dark espresso gradient scrim for mobile reading comfort */
  .hero-mobile-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background: linear-gradient(
      to top,
      rgba(16, 47, 45, 0.94) 0%,
      rgba(21, 63, 59, 0.78) 38%,
      rgba(21, 63, 59, 0.35) 64%,
      rgba(21, 63, 59, 0.0) 85%
    );
  }

  /* ── Content Panel (Mobile Overlay) ─────────────────────────────────────── */
  .hero-content-wrapper {
    position: relative;
    z-index: 3;
    width: 100%;
    padding: 0 var(--space-gutter) max(36px, env(safe-area-inset-bottom, 36px));
    box-sizing: border-box;
  }

  .hero-content-inner {
    max-width: 480px;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Accent detail (desktop only) */
  .hero-accent-mark {
    display: none;
  }

  /* ── Eyebrow ────────────────────────────────────────────────────────────── */
  .hero-eyebrow {
    margin: 0 0 10px 0;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    opacity: 0;
    animation: heroTextReveal 750ms cubic-bezier(0.16, 1, 0.3, 1) 200ms forwards;
  }

  .hero-eyebrow::before {
    content: '';
    display: inline-block;
    width: 16px;
    height: 1px;
    background-color: currentColor;
  }

  /* ── Headline ───────────────────────────────────────────────────────────── */
  .hero-headline {
    margin: 0 0 14px 0;
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 10vw, 3.4rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #FFFFFF;
    opacity: 0;
    animation: heroTextReveal 850ms cubic-bezier(0.16, 1, 0.3, 1) 320ms forwards;
  }

  .headline-row {
    display: block;
  }

  .headline-row--accent em {
    font-style: italic;
    font-weight: 300;
    color: var(--color-ivory);
  }

  /* ── Descriptions ───────────────────────────────────────────────────────── */
  .hero-description {
    margin: 0 0 26px 0;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(246, 242, 234, 0.92);
    max-width: 360px;
    opacity: 0;
    animation: heroTextReveal 750ms cubic-bezier(0.16, 1, 0.3, 1) 450ms forwards;
  }

  .hero-description--desktop {
    display: none;
  }
  .hero-description--mobile {
    display: block;
  }

  /* ── Actions / CTAs ─────────────────────────────────────────────────────── */
  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    opacity: 0;
    animation: heroTextReveal 750ms cubic-bezier(0.16, 1, 0.3, 1) 560ms forwards;
  }

  .hero-cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 52px;
    min-height: 52px;
    padding: 0 24px;
    background-color: var(--color-gold);
    color: var(--color-teal-dark);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-gold);
    transition: all 250ms ease;
    width: 100%;
    box-sizing: border-box;
  }

  .hero-cta-primary:hover {
    background-color: var(--color-gold-hover);
    border-color: var(--color-gold-hover);
    transform: translateY(-1px);
  }

  .hero-cta-arrow {
    display: inline-block;
    transition: transform 200ms ease;
  }

  .hero-cta-primary:hover .hero-cta-arrow {
    transform: translateX(4px);
  }

  .hero-cta-secondary {
    display: none;
  }

  /* ==========================================================================
     DESKTOP LAYOUT (>= 900px: Split-Screen Editorial Composition)
     ========================================================================== */
  @media (min-width: 900px) {
    .hero-section {
      height: 94svh;
      min-height: 660px;
      max-height: 1080px;
      margin-top: 76px; /* Offset fixed header */
      height: calc(100svh - 76px);
      flex-direction: row;
      justify-content: stretch;
      align-items: stretch;
      background-color: var(--color-ivory);
    }

    /* Left 60%: Architectural Photograph Edge-to-Edge */
    .hero-media-wrapper {
      position: relative;
      flex: 0 0 60%;
      width: 60%;
      height: 100%;
    }

    .hero-image {
      object-position: center center;
    }

    .hero-mobile-scrim {
      display: none;
    }

    /* Right 40%: Warm Ivory Editorial Content Panel */
    .hero-content-wrapper {
      position: relative;
      flex: 0 0 40%;
      width: 40%;
      height: 100%;
      background-color: var(--color-ivory);
      border-left: 1px solid var(--color-border);
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: clamp(36px, 5vw, 72px) clamp(36px, 4.5vw, 68px);
    }

    .hero-content-inner {
      max-width: 480px;
      width: 100%;
    }

    /* Antique Gold Accent Mark */
    .hero-accent-mark {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 24px;
      opacity: 0;
      animation: heroTextReveal 750ms cubic-bezier(0.16, 1, 0.3, 1) 150ms forwards;
    }

    .gold-line {
      display: block;
      width: 32px;
      height: 1.5px;
      background-color: var(--color-gold);
    }

    .gold-dot {
      display: block;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background-color: var(--color-gold);
    }

    .hero-eyebrow {
      margin-bottom: 16px;
      font-size: 0.75rem;
      letter-spacing: 0.14em;
      color: var(--color-teal);
    }

    .hero-headline {
      margin-bottom: 20px;
      font-size: clamp(2.8rem, 4.2vw, 4.4rem);
      line-height: 1.05;
      letter-spacing: -0.035em;
      color: var(--color-espresso);
    }

    .headline-row--accent em {
      color: var(--color-teal);
    }

    .hero-description {
      margin-bottom: 36px;
      font-size: clamp(0.9375rem, 1.2vw, 1.0625rem);
      line-height: 1.65;
      color: var(--color-text-muted);
      max-width: 440px;
    }

    .hero-description--desktop {
      display: block;
    }
    .hero-description--mobile {
      display: none;
    }

    .hero-actions {
      flex-direction: row;
      align-items: center;
      gap: 16px;
      width: auto;
    }

    .hero-cta-primary {
      width: auto;
      padding: 0 28px;
      background-color: var(--color-teal);
      border-color: var(--color-teal);
      color: var(--color-ivory);
    }

    .hero-cta-primary:hover {
      background-color: var(--color-teal-dark);
      border-color: var(--color-teal-dark);
      box-shadow: 0 6px 18px rgba(21, 63, 59, 0.18);
    }

    .hero-cta-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 52px;
      min-height: 52px;
      padding: 0 24px;
      background-color: transparent;
      color: var(--color-espresso);
      border: 1px solid var(--color-espresso);
      font-family: var(--font-body);
      font-size: 0.8125rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
      border-radius: var(--radius-xs);
      transition: all 250ms ease;
    }

    .hero-cta-secondary:hover {
      background-color: var(--color-espresso);
      color: var(--color-ivory);
      transform: translateY(-1px);
    }
  }

  @media (min-width: 1280px) {
    .hero-media-wrapper {
      flex: 0 0 61%;
      width: 61%;
    }
    .hero-content-wrapper {
      flex: 0 0 39%;
      width: 39%;
      padding-left: clamp(48px, 5.5vw, 84px);
    }
  }

  /* ── Keyframes & Accessibility ───────────────────────────────────────── */
  @keyframes heroImageSettle {
    0% {
      opacity: 0;
      transform: scale(1.04);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes heroTextReveal {
    0% {
      opacity: 0;
      transform: translateY(18px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image,
    .hero-accent-mark,
    .hero-eyebrow,
    .hero-headline,
    .hero-description,
    .hero-actions {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .hero-cta-primary,
    .hero-cta-secondary,
    .hero-cta-arrow {
      transition: none !important;
    }
  }
</style>
