---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import QuotationModal from '../components/QuotationModal.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';

const primaryProject = projects[0];
const whatsappUrl = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent('Hello Bhavna Space, I would like to discuss an interior architecture project.')}`;
---

<Layout
  title={`${site.name} — Architecture, Interior Design & Furniture`}
  description="Bhavna Space is an interior architecture and design studio in Mumbai creating bespoke residential spaces, tailored furniture, and thoughtful decor with quiet luxury and timeless materiality."
  preloadImage="/images/hero.webp"
>
  <!-- Section A: Hero Component -->
  <Hero projectsUrl="#featured-projects" aboutUrl="/about/" consultationUrl={whatsappUrl} />

  <!-- Section B: Studio Introduction ("Designing for life, not just photography.") -->
  <section class="section-pad theme-ivory studio-intro-section" id="studio-intro" aria-labelledby="studio-heading">
    <div class="container">
      <div class="section-divider">
        <span>01 &bull; The Studio</span>
        <span>Mumbai &bull; Architecture &bull; Interiors</span>
      </div>

      <div class="studio-intro-layout">
        <!-- Text Column -->
        <div class="studio-intro-text reveal-up">
          <span class="eyebrow">Studio Introduction</span>
          <h2 id="studio-heading" class="section-heading-editorial studio-title">
            Designing for life, <em>not just photography.</em>
          </h2>
          <div class="studio-body-narrative">
            <p>
              Based in Mumbai, Bhavna Space approaches interior architecture as an intimate dialogue between inhabitant and space. We create environments centered on natural light, quiet proportions, and honest natural materials.
            </p>
            <p>
              Whether designing a custom residential kitchen, a serene living space, or a complete home, our process is guided by how you move, cook, rest, and gather—creating spaces that feel grounded, tactile, and timeless.
            </p>
          </div>

          <div class="studio-points-grid">
            <div class="studio-point">
              <span class="point-num">01</span>
              <div class="point-content">
                <h3 class="point-title">Spatial Harmony</h3>
                <p class="point-desc">Proportions calibrated for ease of movement, natural daylight, and acoustic warmth.</p>
              </div>
            </div>
            <div class="studio-point">
              <span class="point-num">02</span>
              <div class="point-content">
                <h3 class="point-title">Tactile Materials</h3>
                <p class="point-desc">Solid timber, honed limestone, woven linen, and patinated metals that age gracefully.</p>
              </div>
            </div>
          </div>

          <div class="studio-action-row">
            <a href="/about/" class="btn btn-outline">
              <span>Read Studio Story</span>
              <span class="btn-icon" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Image Column -->
        <div class="studio-intro-media">
          <div class="studio-image-frame image-reveal">
            <img
              src="/images/studio-editorial.jpg"
              alt="Bhavna Space architectural alcove with natural lime-wash plaster, sculptural ceramic vessel, and warm sunlight"
              width="900"
              height="1200"
              class="studio-image"
              loading="lazy"
              decoding="async"
            />
            <div class="media-caption">
              <span class="caption-marker">&bull;</span>
              <span>Bhavna Space Studio &bull; Tactile Plaster &amp; Ceramic Vessel</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section C: Selected Projects ("Spaces with a story.") -->
  <section class="section-pad theme-cream projects-section" id="featured-projects" aria-labelledby="featured-heading">
    <div class="container">
      <div class="section-divider">
        <span>02 &bull; Portfolio</span>
        <span>Selected Works &bull; 2026</span>
      </div>

      <div class="editorial-header-split">
        <div class="editorial-header-left reveal-up">
          <span class="eyebrow">Selected Work</span>
          <h2 id="featured-heading" class="section-heading-editorial">
            Spaces with <em>a story.</em>
          </h2>
        </div>
        <div class="editorial-header-right reveal-up">
          <p class="editorial-subhead">
            Every home begins with a conversation about rituals and materiality. Explore the thoughtful decisions, custom joinery, and architectural details of our latest project.
          </p>
          <a href="/projects/" class="btn-text-link">
            <span>View Complete Project Archive</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Architectural Featured Project Composition -->
      {primaryProject && (
        <article class="featured-project-showcase">
          <!-- Main Hero Image Frame -->
          <a
            href={`/projects/${primaryProject.slug}/`}
            class="project-hero-link"
            aria-label={`View full project details: ${primaryProject.title}`}
          >
            <div class="project-hero-media-box image-reveal">
              <img
                src={primaryProject.hero}
                alt={`${primaryProject.title} — bespoke cabinetry, stone worktops and stainless hardware by Bhavna Space`}
                width="1600"
                height="1000"
                class="project-hero-img"
                loading="lazy"
                decoding="async"
              />
              <div class="project-floating-badge">
                <span class="badge-dot"></span>
                <span>{primaryProject.category}</span>
              </div>
              <div class="project-hover-cta">
                <span>View Full Case Study</span>
                <span class="hover-arrow" aria-hidden="true">&rarr;</span>
              </div>
            </div>
          </a>

          <!-- Asymmetrical Info & Photo Detail Spread -->
          <div class="project-detail-spread">
            <!-- Project Narrative and Specs -->
            <div class="project-spread-info reveal-up">
              <div class="project-spread-meta">
                <span class="project-number">Project № {primaryProject.number}</span>
                <span class="project-location">{primaryProject.location}</span>
                <span class="meta-sep">&bull;</span>
                <span class="project-year">{primaryProject.year}</span>
              </div>
              <h3 class="project-spread-title">
                <a href={`/projects/${primaryProject.slug}/`}>{primaryProject.title}</a>
              </h3>
              <p class="project-spread-desc">
                {primaryProject.description}
              </p>

              <!-- Materials Palette Tag List -->
              <div class="project-materials-block">
                <span class="materials-label">Material Palette:</span>
                <ul class="materials-list">
                  {primaryProject.materials.map((mat) => (
                    <li class="material-tag">{mat}</li>
                  ))}
                </ul>
              </div>

              <div class="project-cta-wrap">
                <a href={`/projects/${primaryProject.slug}/`} class="btn btn-primary">
                  <span>Explore Kitchen Case Study</span>
                  <span class="btn-icon" aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>

            <!-- Detail Photographs Grid (Authentic project images) -->
            <div class="project-spread-gallery">
              <div class="gallery-photo-item image-reveal">
                <img
                  src={primaryProject.images[1] || primaryProject.images[0]}
                  alt="Kalyan Kitchen stone worktop, prep station, and joinery detail"
                  width="700"
                  height="500"
                  class="gallery-img"
                  loading="lazy"
                  decoding="async"
                />
                <span class="gallery-photo-caption">Detail &bull; Stone Worktop &amp; Custom Cabinetry</span>
              </div>
              <div class="gallery-photo-item image-reveal">
                <img
                  src={primaryProject.images[2] || primaryProject.images[0]}
                  alt="Kalyan Kitchen stainless steel hardware and drawer joinery"
                  width="700"
                  height="500"
                  class="gallery-img"
                  loading="lazy"
                  decoding="async"
                />
                <span class="gallery-photo-caption">Detail &bull; Integrated Hardware &amp; Organization</span>
              </div>
            </div>
          </div>
        </article>
      )}
    </div>
  </section>

  <!-- Section D: Services ("From first concept to final detail.") -->
  <section class="section-pad theme-ivory services-section" id="services" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-divider">
        <span>03 &bull; Disciplines</span>
        <span>Studio Capabilities &bull; Turnkey Practice</span>
      </div>

      <div class="editorial-header-split">
        <div class="editorial-header-left reveal-up">
          <span class="eyebrow">Our Disciplines</span>
          <h2 id="services-heading" class="section-heading-editorial">
            From first concept<br />to <em>final detail.</em>
          </h2>
        </div>
        <div class="editorial-header-right reveal-up">
          <p class="editorial-subhead">
            We provide comprehensive architectural interior design, custom furniture development, and rigorous project execution for discerning residential clients.
          </p>
          <a href="/services/" class="btn-text-link">
            <span>Discover All Services</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Services List -->
      <div class="services-list-container">
        <!-- Service 01 -->
        <article class="service-row-item reveal-up">
          <span class="service-row-num">01</span>
          <div class="service-row-main">
            <h3 class="service-row-title">Residential Interior Architecture</h3>
            <p class="service-row-desc">
              Holistic residential transformations from spatial re-planning to bespoke cabinetry, custom finishes, lighting architecture, and ambient curation.
            </p>
          </div>
          <div class="service-row-tag">
            <span>Complete Homes</span>
          </div>
          <a href="/services/" class="service-row-link" aria-label="Learn more about Residential Interior Architecture">
            <span aria-hidden="true">&rarr;</span>
          </a>
        </article>

        <!-- Service 02 -->
        <article class="service-row-item reveal-up">
          <span class="service-row-num">02</span>
          <div class="service-row-main">
            <h3 class="service-row-title">Spatial Planning &amp; Circulation</h3>
            <p class="service-row-desc">
              Optimizing flow, natural light orientation, volumetric balance, and architectural circulation to create natural ease in everyday routines.
            </p>
          </div>
          <div class="service-row-tag">
            <span>Spatial Layouts</span>
          </div>
          <a href="/services/" class="service-row-link" aria-label="Learn more about Spatial Planning">
            <span aria-hidden="true">&rarr;</span>
          </a>
        </article>

        <!-- Service 03 -->
        <article class="service-row-item reveal-up">
          <span class="service-row-num">03</span>
          <div class="service-row-main">
            <h3 class="service-row-title">Bespoke Furniture &amp; Custom Joinery</h3>
            <p class="service-row-desc">
              Curated furniture procurement and studio-designed joinery tailored to the specific proportions and tactile palette of your home.
            </p>
          </div>
          <div class="service-row-tag">
            <span>Custom Made</span>
          </div>
          <a href="/furniture/" class="service-row-link" aria-label="Explore Bespoke Furniture">
            <span aria-hidden="true">&rarr;</span>
          </a>
        </article>

        <!-- Service 04 -->
        <article class="service-row-item reveal-up">
          <span class="service-row-num">04</span>
          <div class="service-row-main">
            <h3 class="service-row-title">Material Direction &amp; Lighting</h3>
            <p class="service-row-desc">
              Architectural lighting design, tactile material palettes, stone selection, and handcrafted surface finishes that compose a calm atmosphere.
            </p>
          </div>
          <div class="service-row-tag">
            <span>Atmosphere</span>
          </div>
          <a href="/services/" class="service-row-link" aria-label="Learn more about Material Direction">
            <span aria-hidden="true">&rarr;</span>
          </a>
        </article>

        <!-- Service 05 -->
        <article class="service-row-item reveal-up">
          <span class="service-row-num">05</span>
          <div class="service-row-main">
            <h3 class="service-row-title">Turnkey Execution &amp; Styling Oversight</h3>
            <p class="service-row-desc">
              Rigorous on-site material coordination, vendor management, artisan collaboration, and final styling to ensure uncompromising quality.
            </p>
          </div>
          <div class="service-row-tag">
            <span>Project Oversight</span>
          </div>
          <a href="/services/" class="service-row-link" aria-label="Learn more about Turnkey Execution">
            <span aria-hidden="true">&rarr;</span>
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- Section E: Design Philosophy & Materiality ("Good design is felt.") -->
  <section class="section-pad theme-cream philosophy-section" id="philosophy" aria-labelledby="philosophy-heading">
    <div class="container">
      <div class="section-divider">
        <span>04 &bull; Ethos &bull; Materiality</span>
        <span>Light &bull; Texture &bull; Proportion</span>
      </div>

      <div class="philosophy-editorial-grid">
        <div class="philosophy-text-column reveal-up">
          <span class="eyebrow">Design Philosophy</span>
          <h2 id="philosophy-heading" class="philosophy-main-title">
            Good design <em>is felt.</em>
          </h2>
          <div class="philosophy-editorial-copy">
            <p>
              We believe a home should never demand attention through noise. True luxury is quiet: it is the quality of morning light crossing a plaster wall, the honesty of solid timber joinery beneath your hand, and proportions that give room to breathe.
            </p>
            <p>
              By balancing architecture, tactile materials, and functional rituals, Bhavna Space builds environments that feel effortlessly grounded—spaces that age gracefully with the people who inhabit them.
            </p>
          </div>

          <!-- Material Palette Details -->
          <div class="material-cards-list">
            <div class="material-card-item">
              <span class="card-accent-dot">&bull;</span>
              <div>
                <strong class="material-name">Solid Walnut &amp; Natural Oak:</strong>
                <span class="material-desc">Warm organic grain, fluted profiles, and matte oiled finishes that celebrate timber texture.</span>
              </div>
            </div>
            <div class="material-card-item">
              <span class="card-accent-dot">&bull;</span>
              <div>
                <strong class="material-name">Honed Travertine &amp; Limestone:</strong>
                <span class="material-desc">Subtle sedimentary veining, softly chamfered edges, and tactile earthy surfaces.</span>
              </div>
            </div>
            <div class="material-card-item">
              <span class="card-accent-dot">&bull;</span>
              <div>
                <strong class="material-name">Boucl&eacute; &amp; Belgian Linen:</strong>
                <span class="material-desc">Curved upholstered silhouettes offering deep comfort, tactile richness, and natural draping.</span>
              </div>
            </div>
            <div class="material-card-item">
              <span class="card-accent-dot">&bull;</span>
              <div>
                <strong class="material-name">Hand-Finished Brass &amp; Bronze:</strong>
                <span class="material-desc">Living patinated metal accents, refined joinery details, and architectural hardware.</span>
              </div>
            </div>
          </div>

          <div class="philosophy-action-row">
            <a href="/furniture/" class="btn btn-primary">
              <span>View Furniture &amp; Materials</span>
              <span class="btn-icon" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Media Column -->
        <div class="philosophy-media-column">
          <div class="philosophy-image-box image-reveal">
            <img
              src="/images/material-craftsmanship.jpg"
              alt="Architectural detail: fluted walnut timber joinery meeting honed travertine stone"
              width="1000"
              height="750"
              class="philosophy-img"
              loading="lazy"
              decoding="async"
            />
            <div class="media-caption">
              <span class="caption-marker">&bull;</span>
              <span>Tactile Craftsmanship &bull; Natural Fluted Walnut &amp; Honed Travertine</span>
            </div>
          </div>

          <div class="philosophy-secondary-image image-reveal">
            <img
              src="/images/furniture-lifestyle.jpg"
              alt="Bespoke curved bouclé armchair and studio table"
              width="900"
              height="600"
              class="philosophy-img-secondary"
              loading="lazy"
              decoding="async"
            />
            <div class="media-caption">
              <span class="caption-marker">&bull;</span>
              <span>Bhavna Space Studio Collection &bull; Sculptural Seating &amp; Joinery</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section F: The Architectural Design Process -->
  <section class="section-pad theme-ivory process-section" id="process" aria-labelledby="process-heading">
    <div class="container">
      <div class="section-divider">
        <span>05 &bull; Process</span>
        <span>Methodology &bull; Concept to Realization</span>
      </div>

      <div class="editorial-header-split">
        <div class="editorial-header-left reveal-up">
          <span class="eyebrow">Our Methodology</span>
          <h2 id="process-heading" class="section-heading-editorial">
            An intentional, <em>collaborative journey.</em>
          </h2>
        </div>
        <div class="editorial-header-right reveal-up">
          <p class="editorial-subhead">
            Designing a home requires rigorous planning, close listening, and meticulous craftsmanship. Here is how we bring each project from initial vision to finished residence.
          </p>
        </div>
      </div>

      <div class="process-steps-grid">
        <!-- Step 1 -->
        <div class="process-step-card reveal-up">
          <div class="process-step-header">
            <span class="step-num">01</span>
            <span class="step-tag">Phase One</span>
          </div>
          <h3 class="step-title">Discovery &amp; Spatial Vision</h3>
          <p class="step-desc">
            We begin with an in-depth consultation to understand your lifestyle, daily routines, aesthetic affinities, and the architectural parameters of your space.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="process-step-card reveal-up">
          <div class="process-step-header">
            <span class="step-num">02</span>
            <span class="step-tag">Phase Two</span>
          </div>
          <h3 class="step-title">Concept &amp; Material Direction</h3>
          <p class="step-desc">
            We formulate spatial layouts, 3D architectural studies, and tactile material palettes—selecting woods, stones, textiles, and lighting schemes.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="process-step-card reveal-up">
          <div class="process-step-header">
            <span class="step-num">03</span>
            <span class="step-tag">Phase Three</span>
          </div>
          <h3 class="step-title">Bespoke Detailing &amp; Craft</h3>
          <p class="step-desc">
            Every piece of cabinetry, joinery, and custom furniture is drawn with millimeter precision and crafted in collaboration with master artisans.
          </p>
        </div>

        <!-- Step 4 -->
        <div class="process-step-card reveal-up">
          <div class="process-step-header">
            <span class="step-num">04</span>
            <span class="step-tag">Phase Four</span>
          </div>
          <h3 class="step-title">On-Site Realization &amp; Styling</h3>
          <p class="step-desc">
            We manage on-site installation with uncompromising oversight, followed by art curation, accessories, and complete white-glove styling.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section G: Contact CTA Banner ("Let's create a space that feels like yours.") -->
  <section class="section-pad theme-cream cta-banner-section" id="contact-cta" aria-labelledby="cta-heading">
    <div class="container">
      <div class="cta-card-box reveal-up">
        <span class="eyebrow">Start a Conversation</span>
        <h2 id="cta-heading" class="cta-headline">
          Let's create a space that<br /><em>feels like yours.</em>
        </h2>
        <p class="cta-lead">
          Every project begins with a conversation about how you want to live. Tell us about your home, your timeline, and your vision.
        </p>

        <div class="cta-action-row">
          <a href="/contact/" class="btn btn-primary" id="home-cta-contact">
            <span>Start a Conversation</span>
            <span class="btn-icon" aria-hidden="true">&rarr;</span>
          </a>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noreferrer noopener"
            class="btn btn-outline"
            id="home-cta-whatsapp"
          >
            <span>WhatsApp Concierge ↗</span>
          </a>
        </div>

        <div class="cta-footer-meta">
          <span>Studio based in {site.location}</span>
          <span class="meta-dot-sep">&bull;</span>
          <span>{site.phone}</span>
          <span class="meta-dot-sep">&bull;</span>
          <span>{site.email}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Homepage Instant Free Quotation Modal Popup (triggers on 15-20s pause) -->
  <QuotationModal delaySeconds={16} />
</Layout>

<style>
  /* ── Editorial Header Split ─────────────────────────────────────────── */
  .editorial-header-split {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: flex-end;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  /* ── Studio Introduction Section ────────────────────────────────────── */
  .studio-intro-layout {
    display: grid;
    grid-template-columns: 1.25fr 0.95fr;
    gap: clamp(3rem, 6vw, 6.5rem);
    align-items: center;
  }

  .studio-title {
    margin: 0 0 1.5rem 0;
    font-size: clamp(2.4rem, 4.8vw, 4.2rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  .studio-title em {
    font-style: italic;
    color: var(--color-primary-text);
  }

  .studio-body-narrative {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.72;
    color: var(--color-text-muted);
    margin-bottom: 2.25rem;
  }

  .studio-points-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    padding: 1.75rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2.25rem;
  }

  .studio-point {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .point-num {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-primary-text);
  }

  .point-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .point-desc {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .studio-image-frame {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background-color: #E2DBD0;
    aspect-ratio: 3 / 4;
  }

  .studio-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(43, 42, 38, 0.88), transparent);
    color: #FCF9EA;
    padding: 20px 20px 14px;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .caption-marker {
    color: var(--color-primary);
  }

  /* ── Featured Projects Section ──────────────────────────────────────── */
  .featured-project-showcase {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .project-hero-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .project-hero-media-box {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background-color: #DDD4C6;
  }

  .project-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-hero-link:hover .project-hero-img {
    transform: scale(1.03);
  }

  .project-floating-badge {
