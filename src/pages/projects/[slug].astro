---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
import { site } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const currentIndex = projects.findIndex((item) => item.slug === project.slug);
const next = projects[(currentIndex + 1) % projects.length];

const whatsappInquiry = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(`Hello Bhavna Space, I would like to inquire about a project similar to ${project.title}.`)}`;
---

<Layout
  title={`${project.title} — ${site.name}`}
  description={project.excerpt}
  image={project.hero}
>
  <article class="project-editorial-article">
    <!-- Editorial Project Header -->
    <header class="project-editorial-header theme-ivory">
      <div class="container">
        <div class="section-divider">
          <span>Project № {project.number}</span>
          <span>{project.location} &bull; {project.year}</span>
        </div>

        <div class="project-header-split">
          <div class="project-title-box">
            <span class="eyebrow eyebrow-teal">{project.category}</span>
            <h1 class="project-main-title">{project.title}</h1>
          </div>
          <div class="project-lead-box">
            <p class="project-lead-text">{project.excerpt}</p>
          </div>
        </div>

        <!-- Full-Width Architectural Hero Image -->
        <div class="project-hero-frame image-reveal">
          <img
            src={project.hero}
            alt={`${project.title} — Architectural Hero View`}
            width="1800"
            height="1200"
            class="project-hero-img"
            fetchpriority="high"
          />
        </div>
      </div>
    </header>

    <!-- Project Architectural Specifications & Narrative -->
    <section class="section-pad theme-cream project-specs-section">
      <div class="container">
        <div class="specs-grid">
          <!-- Story Narrative -->
          <div class="specs-narrative">
            <span class="eyebrow">Design Narrative</span>
            <h2 class="specs-narrative-title">Balancing architectural utility with warmth.</h2>
            <p class="specs-body-text">{project.description}</p>
            <p class="specs-body-text">
              Every detail—from the ergonomic height of the countertop to the integrated under-cabinet ambient lighting—was considered to provide an effortless experience for daily cooking while elevating the aesthetic harmony of the home.
            </p>
          </div>

          <!-- Metadata Spec Sheet -->
          <div class="specs-sheet">
            <h3 class="specs-sheet-title">Project Data</h3>
            <dl class="specs-dl">
              <div class="spec-row">
                <dt>Location</dt>
                <dd>{project.location}</dd>
              </div>
              <div class="spec-row">
                <dt>Typology</dt>
                <dd>{project.category}</dd>
              </div>
              <div class="spec-row">
                <dt>Year Completed</dt>
                <dd>{project.year}</dd>
              </div>
              <div class="spec-row">
                <dt>Spatial Scope</dt>
                <dd>{project.area}</dd>
              </div>
              <div class="spec-row">
                <dt>Studio Role</dt>
                <dd>Complete Architecture, Joinery &amp; Execution</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- Architectural Gallery Sequence -->
    <section class="section-pad theme-ivory project-gallery-sequence">
      <div class="container">
        <div class="section-divider">
          <span>Photographic Sequence</span>
          <span>Spatial Perspectives</span>
        </div>

        <div class="editorial-gallery-mosaic">
          {project.images.map((imgSrc, index) => (
            <figure class:list={['gallery-figure', { 'gallery-figure--wide': index === 0 || index === 3 }]}>
              <div class="gallery-img-box image-reveal">
                <img
                  src={imgSrc}
                  alt={`${project.title} — Detail perspective 0${index + 1}`}
                  width="1600"
                  height="1100"
                  class="gallery-image-elem"
                  loading={index < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
              <figcaption class="gallery-caption">
                <span>Figure 0{index + 1} &bull; Perspective View</span>
                <span>{project.location}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- Material Palette Breakdown -->
    <section class="section-pad theme-teal project-materials-section">
      <div class="container">
        <div class="section-divider">
          <span>Tactile Palette</span>
          <span>Material Specifications</span>
        </div>

        <div class="materials-header">
          <span class="eyebrow">Material Harmony</span>
          <h2 class="materials-headline">Crafted with enduring honest finishes.</h2>
        </div>

        <div class="materials-list-grid">
          {project.materials.map((mat, i) => (
            <div class="material-card">
              <span class="mat-number">0{i + 1}</span>
              <h3 class="mat-name">{mat}</h3>
              <p class="mat-desc">Carefully selected for tactile warmth, durability, and graceful aging in daily residential living.</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Consultation CTA & Next Project Link -->
    <section class="section-pad theme-cream project-footer-nav">
      <div class="container">
        <div class="project-nav-split">
          <div class="nav-inquiry-box">
            <span class="eyebrow">Create a similar space</span>
            <h3 class="nav-inquiry-title">Ready to begin your residential journey?</h3>
            <p class="nav-inquiry-desc">
              Schedule a one-on-one consultation with our design studio to explore how we can tailor your home.
            </p>
            <div class="nav-inquiry-actions">
              <a href="/contact/" class="btn btn-teal">
                <span>Book Consultation</span>
                <span class="btn-icon" aria-hidden="true">&rarr;</span>
              </a>
              <a href={whatsappInquiry} target="_blank" rel="noreferrer" class="btn btn-outline-dark">
                <span>WhatsApp Inquiry ↗</span>
              </a>
            </div>
          </div>

          <div class="nav-next-project-box">
            <span class="eyebrow">Studio Archive</span>
            {projects.length > 1 ? (
              <a href={`/projects/${next.slug}/`} class="next-link-anchor">
                <span class="next-label">Next Project</span>
                <strong class="next-title">{next.title} &rarr;</strong>
              </a>
            ) : (
              <a href="/projects/" class="next-link-anchor">
                <span class="next-label">Explore More Work</span>
                <strong class="next-title">View All Projects &rarr;</strong>
              </a>
            )}
          </div>
        </div>
      </div>
    </section>
  </article>
</Layout>

<style>
  /* ── Project Editorial Header ───────────────────────────────────────── */
  .project-editorial-header {
    padding-top: clamp(120px, 16vw, 190px);
    padding-bottom: clamp(40px, 7vw, 70px);
  }

  .project-header-split {
    display: grid;
    grid-template-columns: 1.2fr 0.9fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: flex-end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .project-main-title {
    margin: 0.5rem 0 0 0;
    font-family: var(--font-heading);
    font-size: clamp(2.6rem, 5vw, 4.75rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-espresso);
  }

  .project-lead-text {
    font-family: var(--font-body);
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0;
  }

  .project-hero-frame {
    border-radius: var(--radius-xs);
    overflow: hidden;
    background-color: #D8D0C4;
    aspect-ratio: 16 / 10;
  }

  .project-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Specs Section ──────────────────────────────────────────────────── */
  .specs-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.85fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: flex-start;
  }

  .specs-narrative-title {
    margin: 0 0 1.5rem 0;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-espresso);
  }

  .specs-body-text {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.75;
    color: var(--color-text-muted);
    margin: 0 0 1.25rem 0;
  }

  .specs-sheet {
    background-color: var(--color-ivory);
    border: 1px solid var(--color-border);
    padding: clamp(2rem, 3.5vw, 2.75rem);
    border-radius: var(--radius-xs);
  }

  .specs-sheet-title {
    margin: 0 0 1.5rem 0;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.75rem;
  }

  .specs-dl {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-body);
    font-size: 0.875rem;
  }

  .spec-row dt {
    color: var(--color-text-muted);
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .spec-row dd {
    margin: 0;
    color: var(--color-espresso);
    font-weight: 600;
    text-align: right;
  }

  /* ── Editorial Gallery Sequence ─────────────────────────────────────── */
  .editorial-gallery-mosaic {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .gallery-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .gallery-figure--wide {
    grid-column: 1 / -1;
  }

  .gallery-img-box {
    border-radius: var(--radius-xs);
    overflow: hidden;
    background-color: #D8D0C4;
    aspect-ratio: 4 / 3;
  }

  .gallery-figure--wide .gallery-img-box {
    aspect-ratio: 16 / 9.5;
  }

  .gallery-image-elem {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-figure:hover .gallery-image-elem {
    transform: scale(1.03);
  }

  .gallery-caption {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ── Material Palette Section ───────────────────────────────────────── */
  .materials-header {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .materials-headline {
    margin: 0.5rem 0 0 0;
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 4.5vw, 3.8rem);
    font-weight: 300;
    color: var(--color-ivory);
  }

  .materials-list-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .material-card {
    background-color: rgba(16, 47, 45, 0.6);
    border: 1px solid var(--color-border-dark);
    padding: 24px;
    border-radius: var(--radius-xs);
    display: flex;
    flex-direction: column;
  }

  .mat-number {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-gold);
    margin-bottom: 12px;
  }

  .mat-name {
    margin: 0 0 8px 0;
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 400;
    color: var(--color-ivory);
  }

  .mat-desc {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-text-light-muted);
  }

  /* ── Project Footer Navigation ──────────────────────────────────────── */
  .project-nav-split {
    display: grid;
    grid-template-columns: 1.3fr 0.8fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
  }

  .nav-inquiry-title {
    margin: 0.5rem 0 0.75rem 0;
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 400;
    color: var(--color-espresso);
  }

  .nav-inquiry-desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 520px;
    margin: 0 0 1.75rem 0;
  }

  .nav-inquiry-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .nav-next-project-box {
    background-color: var(--color-ivory);
    border: 1px solid var(--color-border);
    padding: clamp(2rem, 4vw, 3rem);
    border-radius: var(--radius-xs);
  }

  .next-link-anchor {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
    color: inherit;
  }

  .next-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .next-title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.4vw, 2.2rem);
    font-weight: 400;
    color: var(--color-espresso);
    transition: color 200ms ease;
  }

  .next-link-anchor:hover .next-title {
    color: var(--color-teal);
  }

  /* ── Responsive Adaptations ─────────────────────────────────────────── */
  @media (max-width: 991px) {
    .project-header-split {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .specs-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .materials-list-grid {
      grid-template-columns: 1fr 1fr;
    }
    .project-nav-split {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 639px) {
    .editorial-gallery-mosaic {
      grid-template-columns: 1fr;
    }
    .gallery-figure--wide {
      grid-column: auto;
    }
    .materials-list-grid {
      grid-template-columns: 1fr;
    }
    .nav-inquiry-actions {
      flex-direction: column;
    }
    .nav-inquiry-actions .btn {
      width: 100%;
    }
  }
</style>
