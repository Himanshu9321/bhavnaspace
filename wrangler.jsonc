{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bhavnaspace",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_SITE_URL": "https://bhavnaspace.com"
  }
}
