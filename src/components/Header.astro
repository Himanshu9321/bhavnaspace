---
import { nav, site } from '../data/site';

const consultationMessage = encodeURIComponent("Hello Bhavna Space, I would like to schedule an interior design consultation.");
const consultationUrl = `https://wa.me/${site.whatsappNumber}?text=${consultationMessage}`;

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header" id="site-header" data-header>
  <div class="header-container">
    <!-- Brand Logo -->
    <a class="header-brand" href="/" aria-label="Bhavna Space Home">
      <img
        src="/images/logo-navbar.webp"
        alt="Bhavna Space Monogram"
        width="42"
        height="42"
        class="header-logo-img"
        fetchpriority="high"
        decoding="async"
      />
      <div class="brand-text-lockup">
        <span class="brand-name">Bhavna Space</span>
        <span class="brand-tagline">Interiors • Furniture</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { 'nav-link--active': isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Header Actions (Desktop) -->
    <div class="header-actions">
      <a
        class="btn-consultation"
        href={consultationUrl}
        target="_blank"
        rel="noreferrer noopener"
        aria-label="Book a consultation with Bhavna Space"
      >
        <span>Book Consultation</span>
        <span class="btn-arrow" aria-hidden="true">↗</span>
      </a>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <button
      class="mobile-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
      aria-label="Toggle navigation menu"
      data-menu-toggle
    >
      <span class="hamburger-box" aria-hidden="true">
        <span class="hamburger-inner"></span>
      </span>
      <span class="toggle-text" data-label-open>Menu</span>
      <span class="toggle-text toggle-text--close" data-label-close>Close</span>
    </button>
  </div>
</header>

<!-- Mobile Navigation Drawer / Overlay -->
<div
  class="mobile-panel"
  id="mobile-nav-panel"
  data-mobile-menu
  aria-hidden="true"
  role="dialog"
  aria-label="Site Navigation"
>
  <div class="mobile-panel-inner">
    <div class="mobile-panel-top">
      <span class="mobile-menu-eyebrow">Bhavna Space</span>
      <span class="mobile-menu-descriptor">{site.descriptor}</span>
    </div>

    <nav class="mobile-nav-links" aria-label="Mobile Navigation Links">
      {nav.map((item, index) => (
        <a
          href={item.href}
          class:list={['mobile-link', { 'mobile-link--active': isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
          style={`--item-index: ${index};`}
          data-mobile-link
        >
          <span class="mobile-link-num">0{index + 1}</span>
          <span class="mobile-link-label">{item.label}</span>
          <span class="mobile-link-arrow" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </nav>

    <div class="mobile-panel-bottom">
      <a
        href={consultationUrl}
        class="mobile-consultation-btn"
        target="_blank"
        rel="noreferrer noopener"
        data-mobile-link
      >
        <span>Book a Consultation</span>
        <span aria-hidden="true">↗</span>
      </a>

      <div class="mobile-contact-meta">
        <div class="contact-meta-item">
          <span class="meta-label">Studio Direct</span>
          <a href={`tel:${site.phone.replaceAll(' ', '')}`} class="meta-val">{site.phone}</a>
        </div>
        <div class="contact-meta-item">
          <span class="meta-label">Inquiries</span>
          <a href={`mailto:${site.email}`} class="meta-val">{site.email}</a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* ── Header Base Container ─────────────────────────────────────────── */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 76px;
    background-color: rgba(252, 249, 234, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-border);
    transition: height 250ms ease, background-color 250ms ease, box-shadow 250ms ease, transform 300ms ease;
  }

  .site-header.is-shrunk {
    height: 64px;
    background-color: rgba(252, 249, 234, 0.98);
    box-shadow: 0 4px 20px rgba(43, 42, 38, 0.05);
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  .header-container {
    height: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 var(--space-gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  /* ── Brand Logo ────────────────────────────────────────────────────── */
  .header-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .header-logo-img {
    width: 38px;
    height: 38px;
    object-fit: contain;
    border-radius: 50%;
    transition: transform 250ms ease;
  }

  .header-brand:hover .header-logo-img {
    transform: scale(1.05);
  }

  .brand-text-lockup {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-text);
    line-height: 1.1;
  }

  .brand-tagline {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary-text);
    line-height: 1;
    margin-top: 2px;
  }

  /* ── Desktop Navigation ────────────────────────────────────────────── */
  .desktop-nav {
    display: none;
    align-items: center;
    gap: clamp(20px, 2.5vw, 36px);
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    position: relative;
    padding: 6px 0;
    transition: color 200ms ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1.5px;
    background-color: var(--color-primary);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover {
    color: var(--color-primary-text);
  }

  .nav-link:hover::after,
  .nav-link--active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-link--active {
    color: var(--color-primary-text);
    font-weight: 600;
  }

  /* ── Desktop Consultation CTA ───────────────────────────────────────── */
  .header-actions {
    display: none;
  }

  .btn-consultation {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 20px;
    background-color: var(--color-primary);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius);
    border: 1px solid var(--color-primary);
    transition: all 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-consultation:hover {
    background-color: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
    color: var(--color-text);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(219, 149, 88, 0.25);
  }

  .btn-arrow {
    display: inline-block;
    transition: transform 200ms ease;
  }

  .btn-consultation:hover .btn-arrow {
    transform: translate(2px, -2px);
  }

  /* ── Mobile Hamburger Toggle ────────────────────────────────────────── */
  .mobile-toggle {
    display: flex;
    align-items: center;
    gap: 10px;
    background: none;
    border: 1px solid var(--color-border);
    padding: 8px 14px;
    border-radius: var(--radius);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text);
    min-height: 44px;
    min-width: 44px;
    transition: background-color 200ms ease, border-color 200ms ease;
  }

  .mobile-toggle:hover {
    border-color: var(--color-primary);
  }

  .hamburger-box {
    width: 18px;
    height: 12px;
    position: relative;
    display: inline-block;
  }

  .hamburger-inner {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 1.5px;
    background-color: currentColor;
    transition: background-color 200ms ease;
  }

  .hamburger-inner::before,
  .hamburger-inner::after {
    content: '';
    position: absolute;
    left: 0;
    width: 18px;
    height: 1.5px;
    background-color: currentColor;
    transition: transform 200ms ease, top 200ms ease;
  }

  .hamburger-inner::before { top: -5px; }
  .hamburger-inner::after { top: 5px; }

  .toggle-text--close { display: none; }

  :global(body.menu-open) .toggle-text:not(.toggle-text--close) { display: none; }
  :global(body.menu-open) .toggle-text--close { display: inline; }

  :global(body.menu-open) .hamburger-inner { background-color: transparent; }
  :global(body.menu-open) .hamburger-inner::before {
    top: 0;
    transform: rotate(45deg);
  }
  :global(body.menu-open) .hamburger-inner::after {
    top: 0;
    transform: rotate(-45deg);
  }

  /* ── Mobile Drawer / Overlay ────────────────────────────────────────── */
  .mobile-panel {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 99;
    background-color: var(--color-background);
    color: var(--color-text);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding-top: 76px;
  }

  :global(body.menu-open) .mobile-panel {
    display: block;
  }

  .mobile-panel-inner {
    min-height: calc(100svh - 76px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(24px, 5vw, 40px) var(--space-gutter) max(32px, env(safe-area-inset-bottom, 32px));
    box-sizing: border-box;
  }

  .mobile-panel-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 14px;
    margin-bottom: 20px;
  }

  .mobile-menu-eyebrow {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary-text);
  }

  .mobile-menu-descriptor {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: var(--color-text);
    transition: color 200ms ease;
  }

  .mobile-link-num {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-primary-text);
    width: 32px;
    flex-shrink: 0;
  }

  .mobile-link-label {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 6vw, 2.75rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    flex: 1;
  }

  .mobile-link-arrow {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    transition: transform 200ms ease, color 200ms ease;
  }

  .mobile-link:hover .mobile-link-arrow {
    transform: translateX(4px);
    color: var(--color-primary-text);
  }

  .mobile-link--active .mobile-link-label {
    color: var(--color-primary-text);
    font-style: italic;
  }

  .mobile-panel-bottom {
    margin-top: 36px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .mobile-consultation-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    height: 52px;
    background-color: var(--color-primary);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius);
    box-sizing: border-box;
  }

  .mobile-contact-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--color-border);
  }

  .contact-meta-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .meta-label {
    display: block;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .meta-val {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-text);
    text-decoration: none;
  }

  /* ── Desktop Breakpoint (>= 1024px) ─────────────────────────────────── */
  @media (min-width: 1024px) {
    .header-logo-img {
      width: 42px;
      height: 42px;
    }

    .brand-name {
      font-size: 1.45rem;
    }

    .desktop-nav {
      display: flex;
    }

    .header-actions {
      display: flex;
      align-items: center;
    }

    .mobile-toggle {
      display: none;
    }

    .mobile-panel {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .mobile-panel,
    .mobile-link {
      transition: none !important;
    }
  }
</style>
