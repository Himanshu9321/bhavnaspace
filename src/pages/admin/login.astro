---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { site } from '../../data/site';
---

<AdminLayout title="Admin Sign In — Bhavna Space" requireAuth={false}>
  <main id="admin-main" class="login-page">
    <div class="login-container">
      <!-- Brand Logo / Editorial Header -->
      <header class="login-brand-header">
        <span class="studio-tag">Studio Management</span>
        <h1 class="login-title">BHAVNA SPACE</h1>
        <p class="login-subtitle">Architectural Administration & Correspondence</p>
      </header>

      <!-- Main Login Card -->
      <div class="login-card" id="loginCard">
        <!-- Notification / Error Box -->
        <div id="loginAlert" class="alert-box alert-hidden" role="alert" aria-live="polite">
          <span id="alertIcon" class="alert-icon"></span>
          <span id="alertMessage" class="alert-text"></span>
        </div>

        <!-- STEP 1: Email & Password -->
        <form id="credentialsForm" class="auth-form" novalidate>
          <div class="form-header">
            <h2 class="step-heading">Admin Sign In</h2>
            <p class="step-description">Enter your verified studio credentials to receive an authentication code.</p>
          </div>

          <div class="form-field">
            <label for="adminEmail" class="field-label">Administrator Email</label>
            <div class="input-wrapper">
              <input
                type="email"
                id="adminEmail"
                name="email"
                required
                autocomplete="email"
                placeholder="admin@bhavnaspace.com"
                class="field-input"
              />
            </div>
            <span class="field-hint">Registered studio administrator address</span>
          </div>

          <div class="form-field">
            <div class="label-row">
              <label for="adminPassword" class="field-label">Password</label>
              <button type="button" id="togglePasswordBtn" class="toggle-password" aria-label="Toggle password visibility">
                Show
              </button>
            </div>
            <div class="input-wrapper">
              <input
                type="password"
                id="adminPassword"
                name="password"
                required
                autocomplete="current-password"
                placeholder="••••••••••••"
                class="field-input"
              />
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" id="submitCredentialsBtn" class="btn btn-primary">
              <span class="btn-text">Continue to 2FA Verification</span>
              <span class="btn-spinner" aria-hidden="true"></span>
            </button>
          </div>

          <div class="security-notice">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <span>A 6-digit one-time code will be dispatched to your email via Resend upon verification.</span>
          </div>
        </form>

        <!-- STEP 2: 2FA OTP Verification -->
        <form id="otpForm" class="auth-form form-hidden" novalidate>
          <div class="form-header">
            <div class="badge-2fa">Two-Factor Authentication</div>
            <h2 class="step-heading">Enter Verification Code</h2>
            <p class="step-description">
              We dispatched a 6-digit code to <strong id="sentToEmailDisplay" class="target-email"></strong>.
            </p>
          </div>

          <div class="otp-field-group">
            <label for="otpDigit1" class="field-label center-label">Enter 6-Digit Code</label>
            <div class="otp-inputs-grid" id="otpGrid">
              <input type="text" inputmode="numeric" maxlength="1" class="otp-digit" id="otpDigit1" data-index="0" autocomplete="one-time-code" />
              <input type="text" inputmode="numeric" maxlength="1" class="otp-digit" id="otpDigit2" data-index="1" />
              <input type="text" inputmode="numeric" maxlength="1" class="otp-digit" id="otpDigit3" data-index="2" />
              <input type="text" inputmode="numeric" maxlength="1" class="otp-digit" id="otpDigit4" data-index="3" />
              <input type="text" inputmode="numeric" maxlength="1" class="otp-digit" id="otpDigit5" data-index="4" />
              <input type="text" inputmode="numeric" maxlength="1" class="otp-digit" id="otpDigit6" data-index="5" />
            </div>
            <!-- Hidden consolidated input -->
            <input type="hidden" id="fullOtpInput" name="otp" />

            <div class="timer-row">
              <span class="timer-text" id="timerText">Code expires in <strong id="timerCountdown">10:00</strong></span>
              <button type="button" id="resendOtpBtn" class="link-button" disabled>
                Resend Code
              </button>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" id="submitOtpBtn" class="btn btn-primary">
              <span class="btn-text">Verify & Access Console</span>
              <span class="btn-spinner" aria-hidden="true"></span>
            </button>
            <button type="button" id="backToCredentialsBtn" class="btn btn-secondary">
              Use Different Credentials
            </button>
          </div>
        </form>
      </div>

      <!-- Studio Footer Note -->
      <footer class="login-footer">
        <p>&copy; {new Date().getFullYear()} {site.name} &bull; Mumbai, India</p>
        <a href="/" class="return-link">&larr; Return to Studio Website</a>
      </footer>
    </div>
  </main>
</AdminLayout>

<script>
  // Authentication State
  let currentEmail = '';
  let challengeToken = '';
  let countdownSeconds = 600; // 10 minutes
  let countdownTimer: number | null = null;

  // DOM Elements
  const credentialsForm = document.getElementById('credentialsForm') as HTMLFormElement;
  const otpForm = document.getElementById('otpForm') as HTMLFormElement;
  const emailInput = document.getElementById('adminEmail') as HTMLInputElement;
  const passwordInput = document.getElementById('adminPassword') as HTMLInputElement;
  const togglePasswordBtn = document.getElementById('togglePasswordBtn') as HTMLButtonElement;
  const submitCredentialsBtn = document.getElementById('submitCredentialsBtn') as HTMLButtonElement;
  const submitOtpBtn = document.getElementById('submitOtpBtn') as HTMLButtonElement;
  const backToCredentialsBtn = document.getElementById('backToCredentialsBtn') as HTMLButtonElement;
  const resendOtpBtn = document.getElementById('resendOtpBtn') as HTMLButtonElement;
  const sentToEmailDisplay = document.getElementById('sentToEmailDisplay') as HTMLElement;
  const timerCountdown = document.getElementById('timerCountdown') as HTMLElement;
  const alertBox = document.getElementById('loginAlert') as HTMLElement;
  const alertText = document.getElementById('alertMessage') as HTMLElement;
  const otpDigits = Array.from(document.querySelectorAll<HTMLInputElement>('.otp-digit'));
  const fullOtpInput = document.getElementById('fullOtpInput') as HTMLInputElement;

  // Toggle Password Visibility
  togglePasswordBtn?.addEventListener('click', () => {
    const isPassword = passwordInput.type === 'password';
    passwordInput.type = isPassword ? 'text' : 'password';
    togglePasswordBtn.textContent = isPassword ? 'Hide' : 'Show';
  });

  // Alert Banner Helper
  function showAlert(msg: string, type: 'error' | 'success' | 'info' = 'error') {
    if (!alertBox || !alertText) return;
    alertBox.className = `alert-box alert-${type}`;
    alertText.textContent = msg;
  }

  function hideAlert() {
    if (!alertBox) return;
    alertBox.className = 'alert-box alert-hidden';
  }

  // Countdown Timer
  function startCountdown() {
    if (countdownTimer) clearInterval(countdownTimer);
    countdownSeconds = 600; // 10 minutes
    updateTimerDisplay();

    countdownTimer = window.setInterval(() => {
      countdownSeconds--;
      if (countdownSeconds <= 0) {
        clearInterval(countdownTimer!);
        if (timerCountdown) timerCountdown.textContent = 'Expired';
        if (resendOtpBtn) resendOtpBtn.disabled = false;
        showAlert('Verification code has expired. Please request a new code.', 'info');
      } else {
        updateTimerDisplay();
      }
    }, 1000);
  }

  function updateTimerDisplay() {
    if (!timerCountdown) return;
    const mins = Math.floor(countdownSeconds / 60);
    const secs = countdownSeconds % 60;
    timerCountdown.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
  }

  // OTP Digits Handling (auto-advance & paste)
  otpDigits.forEach((digitInput, idx) => {
    digitInput.addEventListener('input', (e) => {
      const inputEl = e.target as HTMLInputElement;
      const val = inputEl.value.replace(/\D/g, '');
      inputEl.value = val ? val[0] : '';

      updateFullOtp();

      if (val && idx < otpDigits.length - 1) {
        otpDigits[idx + 1].focus();
      }
    });

    digitInput.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && !digitInput.value && idx > 0) {
        otpDigits[idx - 1].focus();
      }
    });

    digitInput.addEventListener('paste', (e) => {
      e.preventDefault();
      const pasteData = e.clipboardData?.getData('text') || '';
      const numbers = pasteData.replace(/\D/g, '').slice(0, 6);
      numbers.split('').forEach((char, i) => {
        if (otpDigits[i]) {
          otpDigits[i].value = char;
        }
      });
      updateFullOtp();
      const nextIdx = Math.min(numbers.length, otpDigits.length - 1);
      otpDigits[nextIdx]?.focus();
    });
  });

  function updateFullOtp() {
    const code = otpDigits.map((d) => d.value).join('');
    if (fullOtpInput) fullOtpInput.value = code;
  }

  // 1. Step 1: Submit Credentials
  credentialsForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideAlert();

    const email = emailInput.value.trim();
    const password = passwordInput.value.trim();

    if (!email || !password) {
      showAlert('Please enter both your administrator email and password.');
      return;
    }

    submitCredentialsBtn.disabled = true;
    submitCredentialsBtn.classList.add('loading');

    try {
      const res = await fetch('/api/admin/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });

      const data = await res.json();

      if (!res.ok) {
        showAlert(data.error || 'Authentication failed. Please check your credentials.');
        return;
      }

      // Transition to Step 2
      currentEmail = email;
      challengeToken = data.challengeToken;

      if (sentToEmailDisplay) sentToEmailDisplay.textContent = email;
      credentialsForm.classList.add('form-hidden');
      otpForm.classList.remove('form-hidden');

      // Clear previous OTP inputs and focus first digit
      otpDigits.forEach((d) => (d.value = ''));
      updateFullOtp();
      startCountdown();
      setTimeout(() => otpDigits[0]?.focus(), 150);

      showAlert(`A 6-digit verification code was sent to ${email}`, 'info');
    } catch (err) {
      showAlert('Network error connecting to authentication server.');
    } finally {
      submitCredentialsBtn.disabled = false;
      submitCredentialsBtn.classList.remove('loading');
    }
  });

  // 2. Step 2: Submit OTP
  otpForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideAlert();

    const otp = fullOtpInput?.value || '';

    if (otp.length !== 6) {
      showAlert('Please enter the complete 6-digit verification code.');
      return;
    }

    submitOtpBtn.disabled = true;
    submitOtpBtn.classList.add('loading');

    try {
      const res = await fetch('/api/admin/verify-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: currentEmail,
          otp,
          challengeToken,
        }),
      });

      const data = await res.json();

      if (!res.ok) {
        showAlert(data.error || 'Verification code invalid or expired.');
        return;
      }

      // Success: HttpOnly cookie set by server response automatically
      try {
        localStorage.removeItem('bhavna_admin_token');
      } catch {}
      showAlert('Verification successful. Redirecting to admin console...', 'success');

      if (countdownTimer) clearInterval(countdownTimer);

      const pathSegments = window.location.pathname.split('/').filter(Boolean);
      const dynamicPrefix = pathSegments[0]?.match(/^\d{8}$/) ? `/${pathSegments[0]}` : '';
      const targetDashboard = dynamicPrefix ? `${dynamicPrefix}/` : '/admin/';

      setTimeout(() => {
        window.location.replace(targetDashboard);
      }, 500);
    } catch (err) {
      showAlert('Network error verifying authentication code.');
    } finally {
      submitOtpBtn.disabled = false;
      submitOtpBtn.classList.remove('loading');
    }
  });

  // Resend OTP Action
  resendOtpBtn?.addEventListener('click', async () => {
    if (!currentEmail || !passwordInput.value) {
      showAlert('Please start over by re-entering your credentials.');
      return;
    }

    resendOtpBtn.disabled = true;
    showAlert('Requesting a new verification code...', 'info');

    try {
      const res = await fetch('/api/admin/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: currentEmail,
          password: passwordInput.value,
        }),
      });

      const data = await res.json();
      if (res.ok && data.challengeToken) {
        challengeToken = data.challengeToken;
        otpDigits.forEach((d) => (d.value = ''));
        updateFullOtp();
        startCountdown();
        showAlert(`A fresh verification code was sent to ${currentEmail}`, 'info');
      } else {
        showAlert(data.error || 'Could not resend code.');
        resendOtpBtn.disabled = false;
      }
    } catch {
      showAlert('Failed to connect to authentication service.');
      resendOtpBtn.disabled = false;
    }
  });

  // Back to Credentials Form
  backToCredentialsBtn?.addEventListener('click', () => {
    if (countdownTimer) clearInterval(countdownTimer);
    otpForm.classList.add('form-hidden');
    credentialsForm.classList.remove('form-hidden');
    hideAlert();
    passwordInput.value = '';
    passwordInput.focus();
  });
</script>

<style>
  .login-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-gutter);
    background-color: var(--color-background);
  }

  .login-container {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .login-brand-header {
    text-align: center;
  }

  .studio-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-primary-text);
    margin-bottom: 0.5rem;
  }

  .login-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    margin: 0;
    color: var(--color-text);
    line-height: 1.15;
  }

  .login-subtitle {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  .login-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 5vw, 2.75rem);
    box-shadow: 0 4px 24px rgba(43, 42, 38, 0.04);
  }

  .form-header {
    margin-bottom: 1.75rem;
  }

  .step-heading {
    font-family: var(--font-heading);
    font-size: 1.625rem;
    font-weight: 500;
    color: var(--color-text);
    margin: 0 0 0.4rem;
    line-height: 1.25;
  }

  .step-description {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .target-email {
    color: var(--color-text);
  }

  .badge-2fa {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background-color: var(--color-background);
    color: var(--color-secondary-text);
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius);
    margin-bottom: 0.75rem;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-hidden {
    display: none !important;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .field-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .center-label {
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .field-hint {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .toggle-password {
    background: none;
    border: none;
    font-size: 0.75rem;
    color: var(--color-primary-text);
    cursor: pointer;
    padding: 0;
    font-family: inherit;
    text-decoration: underline;
  }

  .toggle-password:hover {
    color: var(--color-text);
  }

  .field-input {
    width: 100%;
    padding: 0.8rem 0.9rem;
    font-size: 0.95rem;
    font-family: var(--font-body);
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .field-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(219, 149, 88, 0.15);
  }

  /* OTP Inputs Grid */
  .otp-field-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .otp-inputs-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.5rem;
  }

  .otp-digit {
    width: 100%;
    height: 3.5rem;
    text-align: center;
    font-size: 1.5rem;
    font-weight: 600;
    font-family: monospace;
    color: var(--color-primary-text);
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .otp-digit:focus {
    outline: none;
    border-color: var(--color-primary);
    background-color: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(219, 149, 88, 0.2);
  }

  .timer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    padding: 0 0.25rem;
  }

  .link-button {
    background: none;
    border: none;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-primary-text);
    cursor: pointer;
    text-decoration: underline;
    font-family: inherit;
    padding: 0;
  }

  .link-button:disabled {
    color: #999;
    cursor: not-allowed;
    text-decoration: none;
  }

  /* Form Actions */
  .form-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    font-family: var(--font-body);
    border-radius: var(--radius);
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
    border: 1px solid transparent;
    position: relative;
    min-height: 48px;
  }

  .btn-primary {
    background-color: var(--color-primary);
    color: var(--color-text);
    font-weight: 600;
    border-color: var(--color-primary);
  }

  .btn-primary:hover:not(:disabled) {
    background-color: var(--color-primary-hover);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--color-text);
    border-color: var(--color-border);
  }

  .btn-secondary:hover:not(:disabled) {
    background-color: var(--color-background);
  }

  .btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .btn.loading .btn-text {
    visibility: hidden;
  }

  .btn-spinner {
    display: none;
    position: absolute;
    width: 18px;
    height: 18px;
    border: 2px solid rgba(43, 42, 38, 0.2);
    border-top-color: var(--color-text);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  .btn.loading .btn-spinner {
    display: block;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .security-notice {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-border);
  }

  .security-notice svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-secondary);
  }

  /* Alerts */
  .alert-box {
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    font-size: 0.875rem;
    line-height: 1.45;
    margin-bottom: 1.25rem;
    border: 1px solid transparent;
  }

  .alert-hidden {
    display: none;
  }

  .alert-error {
    background-color: #FDF2EC;
    border-color: #E6BFA2;
    color: #8A3E1B;
  }

  .alert-success {
    background-color: #F2F6ED;
    border-color: #BFD1B4;
    color: #3B572B;
  }

  .alert-info {
    background-color: var(--color-background);
    border-color: var(--color-border);
    color: var(--color-text);
  }

  /* Footer */
  .login-footer {
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .login-footer p {
    margin: 0 0 0.5rem;
  }

  .return-link {
    color: var(--color-primary-text);
    text-decoration: none;
    font-weight: 500;
  }

  .return-link:hover {
    text-decoration: underline;
  }
</style>
