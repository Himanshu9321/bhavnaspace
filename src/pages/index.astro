---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';

const featuredProjects = projects;
const whatsappUrl = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent('Hello Bhavna Space, I would like to discuss an interior architecture project.')}`;
---

<Layout
  title={`${site.name} — Quiet Luxury Interior Architecture & Design`}
  description="Bhavna Space is an interior architecture and design studio creating bespoke residential spaces, tailored furniture, and thoughtful decor with timeless materiality."
  preloadImage="/images/hero.webp"
>
  <!-- Section 1: Hero -->
  <Hero consultationUrl={whatsappUrl} />

  <!-- Section 2: Featured Projects ("Spaces with a story.") -->
  <section class="section-pad theme-ivory" id="featured-projects" aria-labelledby="featured-heading">
    <div class="container">
      <div class="section-divider">
        <span>01 &bull; Portfolio</span>
        <span>Selected Works</span>
      </div>

      <div class="editorial-header-split">
        <div class="editorial-header-left">
          <span class="eyebrow eyebrow-teal">Selected Work</span>
          <h2 id="featured-heading" class="section-heading-editorial">
            Spaces with <em>a story.</em>
          </h2>
        </div>
        <div class="editorial-header-right">
          <p class="editorial-subhead">
            Every space begins with a vision. Explore the details, materials, and thoughtful decisions that bring each project to life.
          </p>
          <a href="/projects/" class="btn-text-link">
            <span>View All Projects</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <div class="featured-project-grid">
        {featuredProjects.map((project, index) => (
          <ProjectCard project={project} featured={index === 0} />
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: Brand Philosophy ("Good design is felt.") -->
  <section class="section-pad theme-cream philosophy-section" aria-labelledby="philosophy-heading">
    <div class="container">
      <div class="section-divider">
        <span>02 &bull; Ethos</span>
        <span>Architecture &bull; Senses</span>
      </div>

      <div class="philosophy-layout">
        <div class="philosophy-text-col reveal-up">
          <span class="eyebrow">Design Philosophy</span>
          <h2 id="philosophy-heading" class="philosophy-title">
            Good design <em>is felt.</em>
          </h2>
          <div class="philosophy-narrative">
            <p>
              We believe a home should never demand attention through noise. True luxury is quiet: it is the quality of morning light crossing a plaster wall, the honesty of solid timber joinery beneath your hand, and proportions that give room to breathe.
            </p>
            <p>
              By balancing architecture, tactile materials, and functional rituals, Bhavna Space builds environments that feel effortlessly grounded—spaces that age gracefully with the people who inhabit them.
            </p>
          </div>
          <div class="philosophy-signature">
            <span class="signature-descriptor">Bhavna Space Studio</span>
            <span class="signature-line">Interiors shaped by light, material, and everyday living.</span>
          </div>
        </div>

        <div class="philosophy-media-col">
          <div class="philosophy-image-frame image-reveal">
            <img
              src="/images/material-craftsmanship.jpg"
              alt="Architectural detail: fluted walnut timber joinery meeting honed travertine stone"
              width="1000"
              height="750"
              class="philosophy-image"
              loading="lazy"
              decoding="async"
            />
            <div class="media-caption">
              <span>Figure 01 &bull; Natural Fluted Walnut &amp; Honed Travertine</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: Services Preview -->
  <section class="section-pad theme-ivory services-preview-section" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-divider">
        <span>03 &bull; Disciplines</span>
        <span>Studio Capabilities</span>
      </div>

      <div class="editorial-header-split">
        <div class="editorial-header-left">
          <span class="eyebrow eyebrow-teal">Our Practice</span>
          <h2 id="services-heading" class="section-heading-editorial">
            From first concept<br />to <em>final detail.</em>
          </h2>
        </div>
        <div class="editorial-header-right">
          <p class="editorial-subhead">
            We provide comprehensive architectural interior design, custom furniture development, and rigorous project execution for discerning residential clients.
          </p>
          <a href="/services/" class="btn-text-link">
            <span>Explore All Services</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <div class="services-curated-list">
        <!-- Service 01 -->
        <article class="service-strip-item">
          <span class="service-strip-num">01</span>
          <div class="service-strip-content">
            <h3 class="service-strip-title">Interior Design</h3>
            <p class="service-strip-desc">
              Holistic residential transformations from spatial re-planning to bespoke cabinetry, custom finishes, lighting architecture, and ambient curation.
            </p>
          </div>
          <a href="/services/" class="service-strip-arrow" aria-label="Learn about Interior Design">
            <span aria-hidden="true">&rarr;</span>
          </a>
        </article>

        <!-- Service 02 -->
        <article class="service-strip-item">
          <span class="service-strip-num">02</span>
          <div class="service-strip-content">
            <h3 class="service-strip-title">Space Planning &amp; Architecture</h3>
            <p class="service-strip-desc">
              Optimizing flow, natural light orientation, volumetric balance, and architectural circulation to create natural ease in everyday routines.
            </p>
          </div>
          <a href="/services/" class="service-strip-arrow" aria-label="Learn about Space Planning">
            <span aria-hidden="true">&rarr;</span>
          </a>
        </article>

        <!-- Service 03 -->
        <article class="service-strip-item">
          <span class="service-strip-num">03</span>
          <div class="service-strip-content">
            <h3 class="service-strip-title">Furniture &amp; Decor</h3>
            <p class="service-strip-desc">
              Curated furniture procurement and bespoke studio-designed joinery tailored to the specific proportions and tactile palette of your home.
            </p>
          </div>
          <a href="/furniture/" class="service-strip-arrow" aria-label="Explore Furniture & Decor">
            <span aria-hidden="true">&rarr;</span>
          </a>
        </article>

        <!-- Service 04 -->
        <article class="service-strip-item">
          <span class="service-strip-num">04</span>
          <div class="service-strip-content">
            <h3 class="service-strip-title">Design Consultation &amp; Direction</h3>
            <p class="service-strip-desc">
              Strategic one-on-one design sessions providing material palettes, fixture selections, color guidance, and styling vision for ongoing projects.
            </p>
          </div>
          <a href="/services/" class="service-strip-arrow" aria-label="Learn about Design Consultation">
            <span aria-hidden="true">&rarr;</span>
          </a>
        </article>

        <!-- Service 05 -->
        <article class="service-strip-item">
          <span class="service-strip-num">05</span>
          <div class="service-strip-content">
            <h3 class="service-strip-title">Execution &amp; Styling Oversight</h3>
            <p class="service-strip-desc">
              Rigorous on-site material coordination, vendor management, and final artwork and accessory styling to ensure uncompromising quality.
            </p>
          </div>
          <a href="/services/" class="service-strip-arrow" aria-label="Learn about Execution & Styling">
            <span aria-hidden="true">&rarr;</span>
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- Section 5: Furniture and Material Stories -->
  <section class="section-pad theme-cream material-story-section" aria-labelledby="material-heading">
    <div class="container">
      <div class="section-divider">
        <span>04 &bull; Materiality</span>
        <span>Craftsmanship &bull; Finishes</span>
      </div>

      <div class="material-story-grid">
        <div class="material-media-panel image-reveal">
          <img
            src="/images/furniture-lifestyle.jpg"
            alt="Bespoke curved cream bouclé armchair, fluted walnut table, and honed stone console by Bhavna Space"
            width="1200"
            height="800"
            class="material-featured-img"
            loading="lazy"
            decoding="async"
          />
          <div class="material-floating-badge">
            <span class="badge-title">Studio Collection</span>
            <span class="badge-sub">Bespoke Residential Commission</span>
          </div>
        </div>

        <div class="material-content-panel">
          <span class="eyebrow">Tactile Quality</span>
          <h2 id="material-heading" class="section-heading-editorial">
            Craftsmanship in <em>every curve.</em>
          </h2>
          <p class="editorial-subhead">
            We craft furniture pieces that function as quiet sculptural anchors. Each piece balances natural timber grain, honed stone surfaces, and soft textiles to create enduring comfort.
          </p>

          <div class="material-breakdown-list">
            <div class="material-pill-item">
              <span class="pill-dot-gold">&bull;</span>
              <strong>Solid Walnut &amp; Oak:</strong>
              <span>Warm organic grain, fluted profiles, and natural matte oiled finishes.</span>
            </div>
            <div class="material-pill-item">
              <span class="pill-dot-gold">&bull;</span>
              <strong>Honed Travertine &amp; Marble:</strong>
              <span>Subtle sedimentary veining, softly chamfered edges, and tactile surfaces.</span>
            </div>
            <div class="material-pill-item">
              <span class="pill-dot-gold">&bull;</span>
              <strong>Boucl&eacute; &amp; Belgian Linen:</strong>
              <span>Curved upholstered silhouettes offering deep comfort and textural depth.</span>
            </div>
            <div class="material-pill-item">
              <span class="pill-dot-gold">&bull;</span>
              <strong>Hand-Finished Brass:</strong>
              <span>Patinated metal accents, refined hardware, and architectural joinery.</span>
            </div>
          </div>

          <div class="material-action-row">
            <a href="/furniture/" class="btn btn-teal">
              <span>View Furniture Stories</span>
              <span class="btn-icon" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 6: Studio Introduction -->
  <section class="section-pad theme-ivory studio-intro-section" aria-labelledby="studio-heading">
    <div class="container">
      <div class="section-divider">
        <span>05 &bull; The Studio</span>
        <span>People &bull; Philosophy</span>
      </div>

      <div class="studio-intro-split">
        <div class="studio-intro-copy">
          <span class="eyebrow eyebrow-teal">About Bhavna Space</span>
          <h2 id="studio-heading" class="section-heading-editorial">
            Designing for life, <em>not just photography.</em>
          </h2>
          <div class="studio-paragraphs">
            <p>
              Based in Mumbai, Bhavna Space approaches interior design as an intimate collaboration between resident and space. We reject disposable trends in favor of enduring architectural proportions, honest natural materials, and tailored comfort.
            </p>
            <p>
              Whether shaping a compact apartment kitchen or an expansive family home, our process is centered on understanding how you move, cook, rest, and gather—crafting environments that feel unmistakably yours.
            </p>
          </div>
          <div class="studio-cta-wrap">
            <a href="/about/" class="btn btn-outline-dark">
              <span>Read Studio Story</span>
              <span class="btn-icon" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <div class="studio-intro-visual">
          <div class="studio-image-frame image-reveal">
            <img
              src="/images/studio-editorial.jpg"
              alt="Bhavna Space architectural alcove with natural lime-wash plaster, sculptural ceramic vessel, and warm sunlight"
              width="800"
              height="1066"
              class="studio-image"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 7: Consultation CTA ("Let's create a space that feels like yours.") -->
  <section class="section-pad theme-teal consultation-banner-section" aria-labelledby="cta-heading">
    <div class="container consultation-banner-inner">
      <div class="consultation-banner-content">
        <span class="eyebrow">Start a Conversation</span>
        <h2 id="cta-heading" class="consultation-headline">
          Let's create a space that<br /><em>feels like yours.</em>
        </h2>
        <p class="consultation-lead">
          Tell us a little about your space, your needs, and what you would love to create. We look forward to exploring possibilities together.
        </p>

        <div class="consultation-actions">
          <a href="/contact/" class="btn btn-gold">
            <span>Start a Conversation</span>
            <span class="btn-icon" aria-hidden="true">&rarr;</span>
          </a>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noreferrer noopener"
            class="btn btn-outline-light"
          >
            <span>WhatsApp Concierge ↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Header Split Layouts ───────────────────────────────────────────── */
  .editorial-header-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: flex-end;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .featured-project-grid {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }

  /* ── Philosophy Section ─────────────────────────────────────────────── */
  .philosophy-layout {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
  }

  .philosophy-title {
    margin: 0 0 1.5rem 0;
    font-family: var(--font-heading);
    font-size: clamp(2.6rem, 5vw, 4.4rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-espresso);
  }

  .philosophy-title em {
    font-style: italic;
    color: var(--color-teal);
  }

  .philosophy-narrative {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.75;
    color: var(--color-text-muted);
    margin-bottom: 2.5rem;
  }

  .philosophy-signature {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .signature-descriptor {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .signature-line {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-espresso);
    font-style: italic;
  }

  .philosophy-image-frame {
    position: relative;
    border-radius: var(--radius-xs);
    overflow: hidden;
    background-color: #D6CEC2;
    aspect-ratio: 4 / 3;
  }

  .philosophy-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(48, 42, 37, 0.85), transparent);
    color: var(--color-ivory);
    padding: 18px 20px 14px;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ── Services Curated List ──────────────────────────────────────────── */
  .services-curated-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
  }

  .service-strip-item {
    display: grid;
    grid-template-columns: 60px 1fr 60px;
    align-items: center;
    gap: 24px;
    padding: clamp(1.75rem, 3.5vw, 2.75rem) 0;
    border-bottom: 1px solid var(--color-border);
    transition: background-color 200ms ease;
  }

  .service-strip-item:hover {
    background-color: rgba(237, 229, 216, 0.4);
    padding-left: 12px;
    padding-right: 12px;
  }

  .service-strip-num {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-gold);
  }

  .service-strip-title {
    margin: 0 0 0.5rem 0;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.6vw, 2.25rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-espresso);
  }

  .service-strip-desc {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 680px;
  }

  .service-strip-arrow {
    font-size: 1.5rem;
    color: var(--color-espresso);
    text-align: right;
    transition: transform 200ms ease, color 200ms ease;
  }

  .service-strip-item:hover .service-strip-arrow {
    transform: translateX(6px);
    color: var(--color-teal);
  }

  /* ── Furniture & Material Section ───────────────────────────────────── */
  .material-story-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(3rem, 6vw, 5.5rem);
    align-items: center;
  }

  .material-media-panel {
    position: relative;
    border-radius: var(--radius-xs);
    overflow: hidden;
    background-color: #D3CABF;
  }

  .material-featured-img {
    width: 100%;
    aspect-ratio: 16 / 11;
    object-fit: cover;
  }

  .material-floating-badge {
    position: absolute;
    bottom: 20px;
    left: 20px;
    background-color: rgba(246, 242, 234, 0.94);
    backdrop-filter: blur(8px);
    padding: 12px 18px;
    border-radius: var(--radius-xs);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .badge-title {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-teal);
  }

  .badge-sub {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .material-breakdown-list {
    margin: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .material-pill-item {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .pill-dot-gold {
    color: var(--color-gold);
    font-size: 1.25rem;
    line-height: 1;
  }

  .material-pill-item strong {
    color: var(--color-espresso);
    font-weight: 600;
    white-space: nowrap;
  }

  .material-action-row {
    margin-top: 2rem;
  }

  /* ── Studio Intro Section ───────────────────────────────────────────── */
  .studio-intro-split {
    display: grid;
    grid-template-columns: 1.2fr 0.9fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
  }

  .studio-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.75;
    color: var(--color-text-muted);
    margin-bottom: 2.5rem;
  }

  .studio-image-frame {
    border-radius: var(--radius-xs);
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background-color: #D3CABF;
  }

  .studio-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Consultation CTA Banner ────────────────────────────────────────── */
  .consultation-banner-inner {
    text-align: center;
  }

  .consultation-banner-content {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .consultation-headline {
    margin: 0.5rem 0 1.5rem 0;
    font-family: var(--font-heading);
    font-size: clamp(2.6rem, 5.5vw, 4.75rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-ivory);
  }

  .consultation-headline em {
    font-style: italic;
    color: var(--color-gold);
  }

  .consultation-lead {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.65;
    color: var(--color-text-light-muted);
    max-width: 640px;
    margin: 0 0 2.5rem 0;
  }

  .consultation-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* ── Responsive Mobile Rules ─────────────────────────────────────────── */
  @media (max-width: 899px) {
    .editorial-header-split {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .philosophy-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .philosophy-media-col {
      order: -1;
    }

    .material-story-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .studio-intro-split {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .studio-intro-visual {
      order: -1;
    }

    .service-strip-item {
      grid-template-columns: 36px 1fr 32px;
      gap: 16px;
    }

    .consultation-actions {
      flex-direction: column;
      width: 100%;
    }

    .consultation-actions .btn {
      width: 100%;
    }
  }
</style>
