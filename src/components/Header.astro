---
import { nav, site } from '../data/site';

// ─── CONTACT CONFIG ──────────────────────────────────────────────────────────
const WHATSAPP_NUMBER = site.whatsappNumber;   // 918652062395
const PHONE_NUMBER    = site.phone;            // +91 86520 62395
// ─────────────────────────────────────────────────────────────────────────────

const quoteMessage  = encodeURIComponent("Hi, I'd like a free quote for an interior design project.");
const quoteUrl      = `https://wa.me/${WHATSAPP_NUMBER}?text=${quoteMessage}`;
const whatsappUrl   = `https://wa.me/${WHATSAPP_NUMBER}`;
const telUrl        = `tel:${PHONE_NUMBER.replaceAll(' ', '')}`;

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

// nav includes Home link in mobile overlay
const allNavLinks = [{ label: 'Home', href: '/' }, ...nav];
---

<header class="site-header" id="site-header" data-header>
  <div class="header-inner">
    <!-- Logo -->
    <a class="header-logo" href="/" aria-label="Bhavna Space home">
      <img
        src="/images/logo-navbar.webp"
        alt="Bhavna Space"
        width="96"
        height="96"
        fetchpriority="high"
        decoding="async"
      />
      <span class="wordmark">Bhavna Space</span>
    </a>

    <!-- Desktop navigation -->
    <nav class="desktop-nav" aria-label="Main">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { 'nav-link--active': isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Desktop CTA -->
    <a
      class="nav-cta"
      href={quoteUrl}
      target="_blank"
      rel="noreferrer noopener"
      aria-label="Get a free interior design quote via WhatsApp"
    >
      Free Quote
    </a>

    <!-- Mobile menu toggle -->
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="menu-toggle-label" data-label-open>Menu</span>
      <span class="menu-toggle-label menu-toggle-label--close" data-label-close aria-hidden="true">Close</span>
    </button>
  </div>
</header>

<!-- Mobile full-screen overlay -->
<div
  class="mobile-menu"
  id="mobile-menu"
  data-mobile-menu
  aria-hidden="true"
  inert
  role="dialog"
  aria-label="Main navigation"
  aria-modal="true"
>
  <div class="mobile-menu-inner">
    <!-- Close at top right -->
    <button
      class="mobile-menu-close"
      type="button"
      aria-label="Close navigation menu"
      data-mobile-close
    >Close</button>

    <!-- Nav links -->
    <nav aria-label="Main" class="mobile-nav">
      {allNavLinks.map((item, index) => (
        <a
          href={item.href}
          class:list={['mobile-nav-link', { 'mobile-nav-link--active': isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
          style={`--i: ${index}`}
          data-mobile-link
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Mobile CTA area -->
    <div class="mobile-cta">
      <a
        href={quoteUrl}
        class="mobile-quote-btn"
        target="_blank"
        rel="noreferrer noopener"
        data-mobile-link
      >
        Get a Free Quote ↗
      </a>
      <div class="mobile-contact-links">
        <a href={telUrl} class="mobile-contact-link" data-mobile-link>
          Call us
        </a>
        <a
          href={whatsappUrl}
          class="mobile-contact-link"
          target="_blank"
          rel="noreferrer noopener"
          data-mobile-link
        >
          WhatsApp
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  /* ── Header shell ───────────────────────────────────────────────── */
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    /* height transition: 72px → 60px after scroll */
    transition:
      height 300ms ease-out,
      transform 400ms ease-out;
    will-change: transform;
    height: 72px;
  }

  /* Shrunk state (JS adds .is-shrunk) */
  .site-header.is-shrunk {
    height: 60px;
  }

  /* Hidden-on-scroll state (JS adds .is-hidden) – mobile only */
  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  .header-inner {
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0 var(--space-gutter);
    gap: 24px;
  }

  /* ── Logo ───────────────────────────────────────────────────────── */
  .header-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    text-decoration: none;
  }

  .header-logo img {
    /* 40px mobile, 48px desktop — controlled below */
    width: auto;
    height: 40px;
    display: block;
  }

  .wordmark {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
    white-space: nowrap;
    line-height: 1;
  }

  /* Hide wordmark on very small screens */
  @media (max-width: 359px) {
    .wordmark { display: none; }
  }

  /* ── Desktop nav ────────────────────────────────────────────────── */
  .desktop-nav {
    display: none; /* shown at 1024px+ */
    align-items: center;
    gap: 32px;
    margin-left: auto;
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    position: relative;
    padding-bottom: 2px;
  }

  /* Animated underline: grows left-to-right on hover */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 300ms ease-out;
  }

  .nav-link:hover::after,
  .nav-link--active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* ── Desktop CTA ────────────────────────────────────────────────── */
  .nav-cta {
    display: none; /* shown at 1024px+ */
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--color-primary);
    color: var(--color-text);
    text-decoration: none;
    padding: 0 20px;
    height: 44px;
    min-width: 44px;
    border-radius: var(--radius);
    align-items: center;
    justify-content: center;
    transition: background 300ms ease-out;
    flex-shrink: 0;
  }

  .nav-cta:hover {
    background: var(--color-primary-hover);
  }

  /* ── Mobile menu toggle ─────────────────────────────────────────── */
  .menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: auto;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0 4px;
    min-width: 44px;
    min-height: 44px;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .menu-toggle-label--close {
    display: none;
  }

  /* When menu is open, swap labels */
  .menu-open .menu-toggle-label:not(.menu-toggle-label--close) {
    display: none;
  }
  .menu-open .menu-toggle-label--close {
    display: block;
    aria-hidden: false;
  }

  /* ── Mobile menu overlay ────────────────────────────────────────── */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 49;
    background: var(--color-background);
    color: var(--color-text);
    opacity: 0;
    pointer-events: none;
    transition: opacity 400ms ease-out;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .menu-open .mobile-menu {
    opacity: 1;
    pointer-events: auto;
  }

  /* Remove inert visually (inert attr handles a11y) */
  .mobile-menu[inert] {
    visibility: hidden;
  }

  .mobile-menu:not([inert]) {
    visibility: visible;
  }

  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 80px var(--space-gutter) 48px;
    padding-top: calc(72px + 24px);
  }

  /* Close button inside overlay */
  .mobile-menu-close {
    display: none; /* handled by toggle button text; hidden here */
  }

  /* ── Mobile nav links ───────────────────────────────────────────── */
  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: auto;
    border-top: 1px solid var(--color-border);
    padding-top: 32px;
  }

  .mobile-nav-link {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 400;
    color: var(--color-text);
    text-decoration: none;
    padding: 20px 0;
    border-bottom: 1px solid var(--color-border);
    display: block;
    letter-spacing: -0.02em;
    line-height: 1.1;

    /* Staggered fade+slide in (set via JS classList) */
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 400ms ease-out,
      transform 400ms ease-out;
    transition-delay: calc(var(--i) * 60ms);
  }

  .menu-open .mobile-nav-link {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-nav-link--active {
    color: var(--color-primary-text);
  }

  /* ── Mobile CTA area ────────────────────────────────────────────── */
  .mobile-cta {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .mobile-quote-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 56px;
    background: var(--color-primary);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius);
    transition: background 300ms ease-out;

    /* stagger after links */
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 400ms ease-out calc(var(--i, 6) * 60ms),
      transform 400ms ease-out calc(var(--i, 6) * 60ms),
      background 300ms ease-out;
  }

  .mobile-quote-btn:hover {
    background: var(--color-primary-hover);
  }

  .menu-open .mobile-quote-btn {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-contact-links {
    display: flex;
    gap: 32px;
  }

  .mobile-contact-link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 3px;
    min-height: 44px;
    display: flex;
    align-items: flex-end;
  }

  .mobile-contact-link:hover {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
  }

  /* ── Desktop breakpoint ─────────────────────────────────────────── */
  @media (min-width: 1024px) {
    .header-logo img {
      height: 48px;
    }

    .desktop-nav {
      display: flex;
    }

    .nav-cta {
      display: flex;
    }

    .menu-toggle {
      display: none;
    }

    .mobile-menu {
      display: none !important;
    }
  }

  /* ── Reduced motion ─────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none !important;
    }
    .mobile-menu {
      transition: none !important;
    }
    .mobile-nav-link,
    .mobile-quote-btn {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
